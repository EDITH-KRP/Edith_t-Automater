# ============================================================================
# Digital Forensics & Evidence Files (SENSITIVE - NEVER COMMIT)
# ============================================================================
# Memory dumps
*.mem
*.raw
*.dmp
*.vmem
*.hibernation

# Disk images
*.dd
*.img
*.bin
*.iso
*.dmg

# EnCase evidence files
*.E01
*.Ex01
*.L01
*.Lx01

# Other forensic formats
*.aff
*.afd
*.afm
*.001
*.vmdk
*.vhd
*.vhdx

# Mobile device images
*.tar
*.backup
*.ab

# ============================================================================
# Tools & External Dependencies
# ============================================================================
# Volatility3 framework (large external dependency)
tools/volatility/volatility3/
tools/volatility/results/

# Autopsy case files
*.db
*.db-journal
*.properties

# Bulk Extractor output
bulk_extractor_output/
*/bulk_extractor_output/

# ExifTool binaries (if not needed in repo)
tools/exiftool/bin/

# ============================================================================
# Evidence Processing & Results
# ============================================================================
# Evidence storage directories
evidence/
Evidence/
EVIDENCE/

# Processing results
results/
Results/
RESULTS/

# Final reports (may contain sensitive data)
reports/Final_Output_reports/
Final_Reports/

# Hash verification files
*.md5
*.sha1
*.sha256
*.hash

# ============================================================================
# Logs & Temporary Files
# ============================================================================
# Log files
*.log
logs/
*.log.*

# Temporary files
*.tmp
*.temp
*.cache
*~

# Backup files
*.bak
*.backup
*.orig

# ============================================================================
# Development Environment
# ============================================================================
# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# PyCharm
.idea/

# VS Code
.vscode/
*.code-workspace

